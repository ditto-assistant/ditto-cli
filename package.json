{
  "name": "@heyditto/cli",
  "version": "1.7.1",
  "description": "Ditto Memory CLI — save, search, fetch, and traverse the Ditto memory graph from the shell.",
  "type": "module",
  "bin": {
    "ditto": "dist/cli.js",
    "heyditto": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --test",
    "prepack": "npm run build",
    "release": "semantic-release",
    "verify": "npm run check && npm run build && npm test && npm pack --dry-run"
  },
  "keywords": [
    "ditto",
    "heyditto",
    "memory",
    "cli",
    "mcp",
    "model-context-protocol"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ditto-assistant/ditto-cli.git"
  },
  "homepage": "https://github.com/ditto-assistant/ditto-cli",
  "bugs": "https://github.com/ditto-assistant/ditto-app/issues/1212",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/node": "^22.15.3",
    "semantic-release": "^25.0.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
