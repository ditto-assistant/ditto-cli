{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heyditto.ai/schemas/dittoconfig/v1.json",
  "$ref": "#/$defs/Config",
  "$defs": {
    "Binding": {
      "properties": {
        "apiBase": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "apiBase"
      ]
    },
    "Config": {
      "properties": {
        "tasks": {
          "$ref": "#/$defs/Tasks"
        },
        "repository": {
          "$ref": "#/$defs/Repository"
        },
        "teleport": {
          "$ref": "#/$defs/Teleport"
        },
        "environment": {
          "$ref": "#/$defs/Environment"
        },
        "policy": {
          "$ref": "#/$defs/Policy"
        },
        "version": {
          "type": "integer",
          "maximum": 1,
          "minimum": 1,
          "description": "Schema version; only 1 is defined"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "version"
      ]
    },
    "Endpoint": {
      "$ref": "#/$defs/Endpoint"
    },
    "Environment": {
      "properties": {
        "vars": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "secrets": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "miseConfig": {
          "type": "string"
        },
        "services": {
          "items": {
            "$ref": "#/$defs/Service"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "HarnessSelection": {
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "auto",
            "claude-code",
            "codex",
            "none"
          ]
        },
        "session": {
          "type": "string",
          "enum": [
            "latest",
            "explicit"
          ]
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "OffloadPolicy": {
      "properties": {
        "unpushed": {
          "type": "string",
          "enum": [
            "refuse",
            "acknowledge"
          ]
        },
        "destination": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Policy": {
      "properties": {
        "repair": {
          "$ref": "#/$defs/RepairPolicy"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "RepairPolicy": {
      "properties": {
        "maxAttempts": {
          "type": "integer",
          "maximum": 10,
          "minimum": 0
        },
        "installOnly": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Repository": {
      "properties": {
        "bindings": {
          "additionalProperties": {
            "$ref": "#/$defs/Binding"
          },
          "type": "object"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0"
        },
        "defaultEndpoint": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Service": {
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0"
        },
        "image": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "healthcheck": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "maximum": 65535,
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name"
      ]
    },
    "Tasks": {
      "properties": {
        "setup": {
          "type": "string"
        },
        "build": {
          "type": "string"
        },
        "test": {
          "type": "string"
        },
        "lint": {
          "type": "string"
        },
        "dev": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Teleport": {
      "properties": {
        "harness": {
          "$ref": "#/$defs/HarnessSelection"
        },
        "offload": {
          "$ref": "#/$defs/OffloadPolicy"
        },
        "captureRoots": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "exclude": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "include": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "requiredMirrors": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    }
  },
  "title": "Ditto repository configuration (.ditto/)"
}
